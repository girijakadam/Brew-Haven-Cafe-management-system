# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/brew_haven
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Server
SERVER_PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=mysql

# Generate a unique secret of at least 32 characters for deployment
JWT_SECRET=replace_with_a_unique_secure_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Optional AI API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Production Security & Admin Provisioning
# In production, set APP_SEED_DEMO_USERS=false so no demo staff/customer accounts are created.
APP_SEED_DEMO_USERS=false
ADMIN_EMAIL=admin@brewhaven.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Admin Officer
ADMIN_PHONE=9876543210
